# ==== OPENAI REALTIME API ====
OPENAI_API_KEY=sk-proj-sua-chave-openai-aqui
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_PROMPT_ID=
OPENAI_AGENT_INSTRUCTIONS="Você é um assistente de voz prestativo, ágil e conciso. Fale em português brasileiro de forma amigável."
OPENAI_VOICE=alloy

# ==== TRAVAS DE SEGURANÇA E BARGE-IN ====
# Duração máxima da chamada em segundos para evitar cobrança em chamadas esquecidas (Padrão: 900s = 15 minutos)
MAX_CALL_DURATION_SEC=900
# Nível 1: VAD Básico | Nível 2: Supressão de Ruído | Nível 3: Sonar / Calibração Acústica Automática
BARGEIN_LEVEL=3

# ==== PONTE DE MÍDIA (mod_audio_fork <-> Node.js) ====
# Porta fixa compartilhada para o servidor HTTP e WebSocket de mídia
MEDIA_WS_PORT=8090
# IP ou Host acessível pelo FreeSWITCH para enviar pacotes de áudio (se omitido, detecta IP local)
AUDIO_FORK_WS_HOST=127.0.0.1

# ==== DRACHTIO SIP SERVER ====
DRACHTIO_HOST=127.0.0.1
DRACHTIO_PORT=9022
DRACHTIO_SECRET=cymru
DRACHTIO_EXTERNAL_IP=127.0.0.1

# ==== FREESWITCH MEDIA SERVER (ESL) ====
FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_SECRET=JambonzR0ck$
